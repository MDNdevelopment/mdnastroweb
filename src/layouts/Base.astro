---
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'MDN Publicidad Studio — Fortalecemos tu Presencia Digital',
  description = 'Estudio creativo de publicidad: diseño y desarrollo de páginas web, gestión de redes sociales y branding. Venezuela · Chile · Miami.',
  image = '/assets/logo.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="MDN Publicidad Studio" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <meta name="theme-color" content="#0C0B0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <!-- Self-hosted fonts (Astro Fonts API): metric-matched fallbacks avoid CLS, no external request -->
    <Font cssVariable="--font-display-src" preload />
    <Font cssVariable="--font-sans-src" preload />
    <Font cssVariable="--font-mono-src" />

    <!-- Cloudflare Turnstile (captcha del formulario de onboarding) -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <!-- JSON-LD: ProfessionalService (Organization) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "MDN Publicidad Studio",
        "url": "https://mdnpublicidad.com",
        "logo": "https://mdnpublicidad.com/assets/mdn-mark.webp",
        "image": "https://mdnpublicidad.com/assets/logo.webp",
        "sameAs": [
          "https://www.instagram.com/mdnpublicidad",
          "https://www.tiktok.com/@mdnpublicidad",
          "https://www.linkedin.com/company/mdnpublicidad"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+1-786-450-4876",
          "email": "info@mdnpublicidad.com",
          "contactType": "customer service"
        },
        "address": [
          { "@type": "PostalAddress", "addressLocality": "Maracaibo", "addressCountry": "VE" },
          { "@type": "PostalAddress", "addressLocality": "Santiago", "addressCountry": "CL" },
          { "@type": "PostalAddress", "addressLocality": "Miami", "addressCountry": "US" }
        ],
        "areaServed": ["Venezuela", "Chile", "Estados Unidos"]
      }
    </script>

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "MDN Publicidad Studio",
        "url": "https://mdnpublicidad.com"
      }
    </script>

    <!-- JSON-LD: Service — Diseño y desarrollo de páginas web -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Diseño y desarrollo de páginas web",
        "name": "Páginas web — MDN Publicidad",
        "description": "Diseño y desarrollo de páginas web: landing pages, sitios corporativos y sistemas a medida con hosting, dominio y soporte incluidos.",
        "provider": { "@type": "ProfessionalService", "name": "MDN Publicidad Studio", "url": "https://mdnpublicidad.com" },
        "areaServed": ["Venezuela", "Chile", "Estados Unidos"],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Planes de páginas web",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": { "@type": "Service", "name": "Landing", "description": "Una sola página, ideal para captar contactos. Entrega en 3 días." },
              "price": "600",
              "priceCurrency": "USD"
            },
            {
              "@type": "Offer",
              "itemOffered": { "@type": "Service", "name": "Web corporativa", "description": "Inicio + 4 secciones para mostrar tu empresa. Entrega en 15 días." },
              "price": "1000",
              "priceCurrency": "USD"
            },
            {
              "@type": "Offer",
              "itemOffered": { "@type": "Service", "name": "Sistema", "description": "Web + panel de control para gestionar contenido, reservas o usuarios. Entrega en 30 días." },
              "price": "2500",
              "priceCurrency": "USD"
            }
          ]
        }
      }
    </script>

    <style is:global>
      @import "../styles/global.css";
    </style>

    <slot name="head" />
  </head>
  <body>
    <div id="mdn-site" class="relative bg-[#0C0B0A] text-[#F6F3EC] overflow-x-clip">

      <!-- Grain overlay -->
      <div
        aria-hidden="true"
        style="position:fixed;inset:0;z-index:9000;pointer-events:none;opacity:.05;mix-blend-mode:overlay;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22120%22 height=%22120%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%222%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/></svg>')"
      ></div>


      <slot />

      <!-- WhatsApp FAB -->
      <a
        href="https://wa.me/17864504876"
        data-whatsapp
        aria-label="Contactar por WhatsApp"
        target="_blank"
        rel="noopener noreferrer"
        class="fixed bottom-6 right-6 z-[8500] w-14 h-14 rounded-full bg-[#25D366] grid place-items-center shadow-[0_8px_22px_rgba(0,0,0,.4)] transition-transform duration-300 hover:scale-110"
      >
        <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff">
          <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.27-1.38a9.86 9.86 0 0 0 4.77 1.22h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2zm0 1.65c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.83c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.25-8.24zm-2.56 4.4c-.13 0-.34.05-.52.24-.18.2-.69.68-.69 1.65 0 .97.71 1.91.81 2.04.1.13 1.39 2.12 3.37 2.98.47.2.84.32 1.12.42.47.15.9.13 1.24.08.38-.06 1.16-.47 1.33-.93.16-.46.16-.85.11-.93-.05-.08-.18-.13-.38-.23-.2-.1-1.16-.57-1.34-.64-.18-.07-.31-.1-.44.1-.13.2-.5.64-.62.77-.11.13-.23.15-.43.05-.2-.1-.84-.31-1.6-.99-.59-.53-.99-1.18-1.11-1.38-.12-.2-.01-.31.09-.41.09-.09.2-.23.3-.35.1-.12.13-.2.2-.34.07-.13.03-.25-.02-.35-.05-.1-.44-1.08-.62-1.48-.16-.38-.32-.33-.44-.34h-.38z"/>
        </svg>
      </a>
    </div>

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
