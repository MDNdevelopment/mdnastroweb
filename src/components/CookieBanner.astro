---
// Banner de consentimiento de cookies. Trabaja junto al Consent Mode v2
// configurado en Base.astro: mientras no haya una decisión guardada en
// localStorage, Google Analytics no almacena cookies de analítica.
---
<div
  id="mdn-cookie-banner"
  data-mdn-cookie-banner
  class="fixed inset-x-0 bottom-0 z-[9200] hidden"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
>
  <div
    class="mx-auto flex flex-col gap-4 border-t border-white/10 bg-[#0A0908] px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
    style="max-width:1280px; box-shadow:0 -12px 30px rgba(0,0,0,.35);"
  >
    <p class="m-0 max-w-[640px] text-[14px] leading-[1.55] text-[#B8B3A8]">
      Usamos cookies propias y de terceros para analizar el uso del sitio y mejorar tu experiencia. Puedes aceptarlas o rechazarlas; consulta más en nuestra
      <a href="/politica-de-cookies/" class="text-[#F6F3EC] underline decoration-white/30 underline-offset-2 hover:text-[#FFB200]">política de cookies</a>
      y
      <a href="/politica-de-privacidad/" class="text-[#F6F3EC] underline decoration-white/30 underline-offset-2 hover:text-[#FFB200]">política de privacidad</a>.
    </p>
    <div class="flex shrink-0 items-center gap-3">
      <button
        type="button"
        data-mdn-cookie-reject
        class="text-[13px] font-semibold tracking-[.5px] uppercase text-[#F6F3EC] bg-transparent border border-white/20 rounded-full px-5 py-2.5 transition-colors duration-250 hover:bg-white/10"
      >
        Rechazar
      </button>
      <button
        type="button"
        data-mdn-cookie-accept
        class="text-[13px] font-bold tracking-[.5px] uppercase text-[#0C0B0A] bg-[#FFB200] rounded-full px-5 py-2.5 transition-colors duration-250 hover:bg-[#FFC233]"
      >
        Aceptar
      </button>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      gtag?: (...args: unknown[]) => void;
    }
  }

  const STORAGE_KEY = 'mdn-cookie-consent';

  function grantConsent() {
    window.gtag?.('consent', 'update', {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
    });
  }

  function showBanner() {
    document.querySelectorAll<HTMLElement>('[data-mdn-cookie-banner]').forEach((el) => {
      el.classList.remove('hidden');
    });
  }

  function hideBanner() {
    document.querySelectorAll<HTMLElement>('[data-mdn-cookie-banner]').forEach((el) => {
      el.classList.add('hidden');
    });
  }

  function initBanner() {
    let consent: string | null = null;
    try {
      consent = localStorage.getItem(STORAGE_KEY);
    } catch (e) {}

    if (consent === 'accepted') {
      grantConsent();
    } else if (consent !== 'rejected') {
      showBanner();
    }

    document.querySelectorAll<HTMLElement>('[data-mdn-cookie-accept]').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          localStorage.setItem(STORAGE_KEY, 'accepted');
        } catch (e) {}
        grantConsent();
        hideBanner();
      });
    });

    document.querySelectorAll<HTMLElement>('[data-mdn-cookie-reject]').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          localStorage.setItem(STORAGE_KEY, 'rejected');
        } catch (e) {}
        hideBanner();
      });
    });
  }

  initBanner();

  // Permite reabrir el banner desde cualquier página (enlace "Configurar cookies" en el footer)
  window.addEventListener('mdn:open-cookie-settings', () => {
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch (e) {}
    showBanner();
  });
</script>
