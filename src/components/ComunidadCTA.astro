---
---
<section style="padding: clamp(20px,4vw,40px) clamp(20px,5vw,64px);">
  <div
    data-reveal
    class="relative max-w-[1280px] mx-auto bg-[#FFB200] rounded-[28px] overflow-hidden opacity-0 translate-y-6"
    style="padding: clamp(36px,5vw,70px);"
  >
    <img
      src="/assets/mdn-mark.webp"
      alt=""
      aria-hidden="true"
      class="absolute right-[-40px] bottom-[-60px] w-[340px] opacity-[.18] pointer-events-none brightness-0"
    />

    <div class="relative flex flex-wrap items-center justify-between gap-8">
      <div>
        <p class="m-0 mb-2.5 font-sans font-bold text-[13px] tracking-[3px] uppercase text-[rgba(12,11,10,.6)]">@mdnpublicidad</p>
        <h2 class="m-0 font-display font-extrabold uppercase leading-[.95] tracking-[-0.5px] text-[#0C0B0A]" style="font-size:clamp(30px,4.6vw,62px);">
          Únete a nuestra<br />comunidad
        </h2>
      </div>

      <div class="flex flex-col gap-3.5">
        <a
          href="https://www.instagram.com/mdnpublicidad"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between min-w-[240px] gap-10 font-display font-bold text-[24px] uppercase text-[#0C0B0A] no-underline border-b-2 border-[rgba(12,11,10,.25)] pb-2 transition-all duration-300 hover:pl-2.5"
        >
          Instagram
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M9 7h8v8"/>
          </svg>
        </a>
        <a
          href="https://www.tiktok.com/@mdnpublicidad"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between min-w-[240px] gap-10 font-display font-bold text-[24px] uppercase text-[#0C0B0A] no-underline border-b-2 border-[rgba(12,11,10,.25)] pb-2 transition-all duration-300 hover:pl-2.5"
        >
          TikTok
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M9 7h8v8"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/company/mdnpublicidad"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between min-w-[240px] gap-10 font-display font-bold text-[24px] uppercase text-[#0C0B0A] no-underline border-b-2 border-[rgba(12,11,10,.25)] pb-2 transition-all duration-300 hover:pl-2.5"
        >
          LinkedIn
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M9 7h8v8"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
