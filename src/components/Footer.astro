---
const socials = {
  LinkedIn: '<path d="M4.98 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3.4 9h3.16v11.5H3.4zM9.5 9h3.03v1.57h.04c.42-.8 1.45-1.65 2.98-1.65 3.19 0 3.78 2.1 3.78 4.83v6.75h-3.15v-5.98c0-1.43-.03-3.26-1.99-3.26-1.99 0-2.29 1.55-2.29 3.15v6.09H9.5z" fill="#fff"/>',
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="#fff" stroke-width="1.7"/><circle cx="12" cy="12" r="4" fill="none" stroke="#fff" stroke-width="1.7"/><circle cx="17.2" cy="6.8" r="1.2" fill="#fff"/>',
  TikTok: '<path d="M14 3c.3 2.1 1.6 3.6 3.7 3.9v2.4c-1.3.05-2.5-.35-3.6-1.05v5.6c0 3.2-2.4 5.2-5 5.2-2.6 0-4.4-2-4.4-4.4 0-2.7 2.3-4.6 5.1-4.1v2.5c-.4-.13-.9-.18-1.3-.05-1 .3-1.5 1.1-1.3 2.1.18.9 1.1 1.5 2 1.4 1-.1 1.7-.9 1.7-2V3z" fill="#fff"/>',
  Facebook: '<path d="M13.5 21v-7h2.3l.4-2.7h-2.7V9.5c0-.8.3-1.3 1.4-1.3h1.4V5.7c-.7-.1-1.5-.15-2.2-.15-2.2 0-3.7 1.3-3.7 3.8v1.95H8v2.7h2.3V21z" fill="#fff"/>',
};

const socialLinks: Record<string, string> = {
  LinkedIn: 'https://www.linkedin.com/company/mdnpublicidad',
  Instagram: 'https://www.instagram.com/mdnpublicidad',
  TikTok: 'https://www.tiktok.com/@mdnpublicidad',
  Facebook: 'https://www.facebook.com/mdnpublicidad/?locale=es_LA',
};
---
<footer
  class="relative border-t border-white/10 bg-[#0A0908] overflow-hidden"
  style="padding: clamp(50px,7vh,80px) clamp(20px,5vw,64px) 30px;"
>
  <div class="max-w-[1280px] mx-auto">
    <div class="flex flex-wrap justify-between" style="gap:clamp(34px,5vw,72px);">

      <!-- Brand column -->
      <div class="flex-[1_1_300px] max-w-[380px]">
        <img src="/assets/mdn-mark.webp" alt="MDN Publicidad Studio" width="72" height="72" style="height:72px;width:auto;display:block;" />
        <p class="mt-5 mb-6 max-w-[300px] text-[18px] leading-[1.65] text-[#9a9489]">
          Estudio creativo de marketing. Convertimos marcas en presencia digital medible, con alcance local, nacional e internacional.
        </p>
      </div>

      <!-- Locations column -->
      <div class="flex-[1_1_250px]">
        <p class="m-0 mb-4 font-display font-bold text-[13px] tracking-[2px] uppercase text-[#FFB200]">Ubícanos</p>
        <div class="flex flex-col gap-2.5">
          {[
            {
              city: 'Maracaibo', country: 'Venezuela',
              flag: `<defs><clipPath id="flgVE"><circle cx="14" cy="14" r="13"/></clipPath></defs><g clip-path="url(#flgVE)"><rect width="28" height="9.34" fill="#FCD116"/><rect y="9.34" width="28" height="9.33" fill="#00247D"/><rect y="18.67" width="28" height="9.33" fill="#CF142B"/><g fill="#fff"><circle cx="4.6" cy="15.2" r="0.75"/><circle cx="7.9" cy="13.1" r="0.75"/><circle cx="11.2" cy="11.9" r="0.75"/><circle cx="14" cy="11.5" r="0.75"/><circle cx="16.8" cy="11.9" r="0.75"/><circle cx="20.1" cy="13.1" r="0.75"/><circle cx="23.4" cy="15.2" r="0.75"/></g></g><circle cx="14" cy="14" r="13" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.4"/>`
            },
            {
              city: 'Santiago', country: 'Chile',
              flag: `<defs><clipPath id="flgCL"><circle cx="14" cy="14" r="13"/></clipPath></defs><g clip-path="url(#flgCL)"><rect width="28" height="14" fill="#fff"/><rect y="14" width="28" height="14" fill="#D52B1E"/><rect width="11" height="14" fill="#0039A6"/><path d="M5.5 3.4l1.04 3.2H9.9L7.18 8.58l1.04 3.2L5.5 9.8 2.78 11.78l1.04-3.2L1.1 6.6h3.36z" fill="#fff"/></g><circle cx="14" cy="14" r="13" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.4"/>`
            },
            {
              city: 'Miami', country: 'Estados Unidos',
              flag: `<defs><clipPath id="flgUS"><circle cx="14" cy="14" r="13"/></clipPath></defs><g clip-path="url(#flgUS)"><rect width="28" height="28" fill="#fff"/><rect width="28" height="4" fill="#B22234"/><rect width="28" height="4" y="8" fill="#B22234"/><rect width="28" height="4" y="16" fill="#B22234"/><rect width="28" height="4" y="24" fill="#B22234"/><rect width="13" height="15" fill="#3C3B6E"/><g fill="#fff"><circle cx="2.8" cy="2.5" r="0.55"/><circle cx="6.2" cy="2.5" r="0.55"/><circle cx="9.6" cy="2.5" r="0.55"/><circle cx="4.5" cy="5" r="0.55"/><circle cx="7.9" cy="5" r="0.55"/><circle cx="11.3" cy="5" r="0.55"/><circle cx="2.8" cy="7.5" r="0.55"/><circle cx="6.2" cy="7.5" r="0.55"/><circle cx="9.6" cy="7.5" r="0.55"/><circle cx="4.5" cy="10" r="0.55"/><circle cx="7.9" cy="10" r="0.55"/><circle cx="11.3" cy="10" r="0.55"/><circle cx="2.8" cy="12.5" r="0.55"/><circle cx="6.2" cy="12.5" r="0.55"/><circle cx="9.6" cy="12.5" r="0.55"/></g></g><circle cx="14" cy="14" r="13" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.4"/>`
            },
          ].map((loc, i) => (
            <div
              class="flex items-center gap-3.5"
              style={`padding:9px 0;${i > 0 ? 'border-top:1px solid rgba(255,255,255,.06);' : ''}`}
            >
              <svg width="26" height="26" viewBox="0 0 28 28" style="flex:0 0 auto;" set:html={loc.flag} />
              <span class="flex flex-col leading-[1.25]">
                <span class="font-semibold text-[15px] text-[#F6F3EC]">{loc.city}</span>
                <span class="text-[12px] text-[#8a857b]">{loc.country}</span>
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Contact + Social column -->
      <div class="flex-[1_1_220px] flex flex-col gap-8">
        <div>
          <p class="m-0 mb-4 font-display font-bold text-[13px] tracking-[2px] uppercase text-[#FFB200]">Contacto</p>
          <div class="flex flex-col gap-3">
            <a href="tel:+17864504876" data-ga-event="phone_click" data-ga-location="footer" class="flex items-center gap-2.5 text-[15px] text-[#F6F3EC] no-underline transition-colors duration-250 hover:text-[#FFB200]">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#FFB200" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              +1 (786) 450-4876
            </a>
            <a href="mailto:info@mdnpublicidad.com" data-ga-event="email_click" data-ga-location="footer" class="flex items-center gap-2.5 text-[15px] text-[#F6F3EC] no-underline transition-colors duration-250 hover:text-[#FFB200]">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#FFB200" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m2 7 10 6 10-6"/>
              </svg>
              info@mdnpublicidad.com
            </a>
          </div>
        </div>

        <div>
          <p class="m-0 mb-4 font-display font-bold text-[13px] tracking-[2px] uppercase text-[#FFB200]">Síguenos</p>
          <div class="flex gap-3 flex-wrap mb-3.5">
            {Object.entries(socials).map(([name, icon]) => (
              <a
                href={socialLinks[name]}
                aria-label={name}
                target="_blank"
                rel="noopener noreferrer"
                data-ga-event="social_click"
                data-ga-network={name}
                data-ga-location="footer"
                class="w-10 h-10 rounded-full bg-white/[.06] border border-white/10 grid place-items-center transition-all duration-250 hover:bg-[#FFB200] hover:-translate-y-1 group"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" set:html={icon} />
              </a>
            ))}
          </div>
          <p class="m-0 text-[16px] text-[#9a9489]">@mdnpublicidad</p>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-6 border-t border-white/[.08] flex flex-wrap gap-3.5 justify-between items-center">
      <p class="m-0 text-[13px] text-[#6f6a61]">© 2026 MDN Publicidad Studio. Todos los derechos reservados.</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/politica-de-privacidad/" class="text-[13px] text-[#6f6a61] no-underline transition-colors duration-250 hover:text-[#FFB200]">Política de privacidad</a>
        <a href="/politica-de-cookies/" class="text-[13px] text-[#6f6a61] no-underline transition-colors duration-250 hover:text-[#FFB200]">Política de cookies</a>
        <button
          type="button"
          data-mdn-cookie-settings
          class="text-[13px] text-[#6f6a61] bg-transparent border-none p-0 cursor-pointer transition-colors duration-250 hover:text-[#FFB200]"
        >
          Configurar cookies
        </button>
      </div>
      <p class="m-0 text-[13px] text-[#6f6a61] tracking-[1px]">Fortalecemos tu presencia digital.</p>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-mdn-cookie-settings]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('mdn:open-cookie-settings'));
    });
  });
</script>
